# ============================================
# ERPNext Docker 部署环境变量配置
# 德川/裕霖业务管理系统
# ============================================
# 使用方法: 复制此文件为 .env 并修改配置
# cp env.example .env
# ============================================

# ==================== 基础配置 ====================
# 项目名称（用于容器命名前缀）
COMPOSE_PROJECT_NAME=erpnext-dechuan

# 部署环境: development | production
ENVIRONMENT=production

# 站点名称（ERPNext站点域名）
SITE_NAME=erp.dechuan.com

# ==================== 数据库配置 ====================
# MariaDB 配置
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=erpnext
MYSQL_USER=erpnext
MYSQL_PASSWORD=your_secure_db_password_here
MYSQL_HOST=mariadb
MYSQL_PORT=3306

# ==================== Redis 配置 ====================
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# ==================== ERPNext 配置 ====================
# Frappe/ERPNext 版本
FRAPPE_VERSION=version-16
ERPNEXT_VERSION=version-15

# 管理员密码
ADMIN_PASSWORD=your_admin_password_here

# 加密密钥（用于敏感数据加密，建议32字符以上的随机字符串）
ENCRYPTION_KEY=your_random_encryption_key_32chars_minimum

# ==================== AI Agent 配置 ====================
# OpenAI API配置（用于AI智能体）
OPENAI_API_KEY=sk-your_openai_api_key_here

# Claude API配置（可选）
CLAUDE_API_KEY=sk-ant-your_claude_api_key_here

# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 企业微信配置（用于通知推送）
WECHAT_CORP_ID=ww_your_corp_id
WECHAT_CORP_SECRET=your_corp_secret
WECHAT_AGENT_ID=1000001

# ==================== 网络配置 ====================
# HTTP端口（Nginx监听端口）
HTTP_PORT=80
HTTPS_PORT=443

# 后端服务端口
WEBSERVER_PORT=8000
SOCKETIO_PORT=9000

# ==================== SSL 配置 ====================
# SSL证书路径（生产环境必须配置）
SSL_CERTIFICATE=/etc/nginx/ssl/fullchain.pem
SSL_CERTIFICATE_KEY=/etc/nginx/ssl/privkey.pem

# ==================== 备份配置 ====================
# 备份保留天数
BACKUP_RETENTION_DAYS=30

# 备份存储路径
BACKUP_PATH=/var/backups/erpnext

# 是否启用自动备份
ENABLE_AUTO_BACKUP=true

# ==================== 性能配置 ====================
# Gunicorn workers数量（建议 2*CPU核心数+1）
GUNICORN_WORKERS=4

# Worker超时时间（秒）
WORKER_TIMEOUT=120

# ==================== 日志配置 ====================
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 日志保留天数
LOG_RETENTION_DAYS=14

# ==================== 邮件配置 ====================
# SMTP服务器配置
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_LOGIN=noreply@dechuan.com
MAIL_PASSWORD=your_mail_password
