# ============================================
# ERPNext Docker 部署环境变量配置 - 开发环境
# 德川/裕霖业务管理系统
# ============================================
# 使用方法: 复制此文件为 .env 并根据需要修改
# cp env.development.example .env
# ============================================

# ==================== 基础配置 ====================
# 项目名称（用于容器命名前缀）
COMPOSE_PROJECT_NAME=erpnext-dev

# 部署环境
ENVIRONMENT=development

# 站点名称（本地开发使用 localhost）
SITE_NAME=erp.localhost

# ==================== 数据库配置 ====================
# MariaDB 配置（开发环境使用简单密码）
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=erpnext
MYSQL_USER=erpnext
MYSQL_PASSWORD=erpnext123
MYSQL_HOST=mariadb
MYSQL_PORT=3306

# ==================== Redis 配置 ====================
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# ==================== Frappe 配置 ====================
# Frappe 版本（ERPNext 使用本地 v16 代码）
FRAPPE_VERSION=version-16

# 管理员密码（开发环境）
ADMIN_PASSWORD=admin123

# 加密密钥（开发环境使用固定值便于调试）
ENCRYPTION_KEY=dev_encryption_key_for_local_testing

# ==================== AI Agent 配置（可选）====================
# 开发环境可留空，需要测试AI功能时再填写
# OpenAI API配置
OPENAI_API_KEY=

# DeepSeek API配置
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Claude API配置（可选）
CLAUDE_API_KEY=

# 企业微信配置（可选，本地开发可留空）
WECHAT_CORP_ID=
WECHAT_CORP_SECRET=
WECHAT_AGENT_ID=

# ==================== 网络配置 ====================
# HTTP端口（开发环境可使用非标准端口避免冲突）
HTTP_PORT=8080
HTTPS_PORT=8443

# 后端服务端口
WEBSERVER_PORT=8000
SOCKETIO_PORT=9000

# ==================== SSL 配置 ====================
# 开发环境使用自签名证书（init.sh 会自动生成）
SSL_CERTIFICATE=/etc/nginx/ssl/fullchain.pem
SSL_CERTIFICATE_KEY=/etc/nginx/ssl/privkey.pem

# ==================== 备份配置 ====================
# 开发环境备份配置
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=/var/lib/erpnext/backups
ENABLE_AUTO_BACKUP=false

# ==================== 性能配置 ====================
# 开发环境减少 Worker 数量节省资源
GUNICORN_WORKERS=2
WORKER_TIMEOUT=300

# ==================== 日志配置 ====================
# 开发环境使用 DEBUG 级别便于调试
LOG_LEVEL=DEBUG
LOG_RETENTION_DAYS=7

# ==================== 邮件配置（可选）====================
# 开发环境可使用 MailHog 等本地邮件测试工具
# 或留空禁用邮件功能
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=false
MAIL_LOGIN=
MAIL_PASSWORD=

# ==================== 开发环境特有配置 ====================
# 启用开发者模式
DEVELOPER_MODE=1

# 禁用邮件验证
DISABLE_EMAIL_VERIFICATION=1

# 自动重载代码（热更新）
AUTO_RELOAD=1
